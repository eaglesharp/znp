{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "anhskohbo/no-captcha": "^3.2",
        "barryvdh/laravel-dompdf": "^1.0",
        "brick/math": "^0.9",
        "cakephp/chronos": "^2.0",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^6.3",
        "intervention/image": "^2.5",
        "jrean/laravel-user-verification": "dev-master",
        "laracasts/flash": "^3.1",
        "laravel/framework": "^7.24",
        "laravel/socialite": "^4.4",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.1",
        "maatwebsite/excel": "^3.1",
        "niklasravnsborg/laravel-pdf": "^4.1",
        "paypal/rest-api-sdk-php": "^1.14",
        "rahulreghunath/textlocal": "^1.0",
        "razorpay/razorpay": "2.*",
        "rtconner/laravel-tagging": "~2.0",
        "spatie/laravel-newsletter": "^4.8",
        "stevebauman/location": "^6.5",
        "stripe/stripe-php": "^7.49",
        "tzsk/payu": "^5.0",
        "yajra/laravel-datatables": "^1.5",
        "zanysoft/laravel-zip": "^1.0"
    },
    "require-dev": {
        "facade/ignition": "^2.0",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore": {
                "PKSA-qstp-ffwg-8hp6": "dompdf advisory",
                "PKSA-5vz3-q51h-7mg4": "dompdf advisory",
                "PKSA-7ztm-rpt3-qqzk": "dompdf advisory",
                "PKSA-4jrs-y99s-q8j6": "dompdf advisory",
                "PKSA-hbk6-2vfz-8f8n": "dompdf advisory",
                "PKSA-kj9c-tr41-t8mj": "dompdf advisory",
                "PKSA-872h-8556-2chm": "dompdf advisory",
                "PKSA-qsyb-3psh-f1t3": "php-svg-lib advisory",
                "PKSA-3dsp-r6t7-8xmz": "php-svg-lib advisory",
                "PKSA-cwpj-dtf9-6fg1": "php-svg-lib advisory"
            }
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
