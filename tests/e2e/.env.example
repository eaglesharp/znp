# ───────────────────────────────────────────────────────────────────
#  ZNP E2E test config
#  Copy this file to `.env` and fill in values for the target env.
# ───────────────────────────────────────────────────────────────────

# Where the app runs. Local Laravel dev server defaults to port 8000.
#   local:   http://127.0.0.1:8000
#   staging: https://staging.zeronoticeperiod.com
#   prod:    https://zeronoticeperiod.com   ← USE WITH MODE=dryrun ONLY
BASE_URL=http://127.0.0.1:8000

# A pre-existing company login on the target environment.
# For local: run `php tests/e2e/seed-local-company.php` to create one.
COMPANY_EMAIL=znp_pj_test@example.com
COMPANY_PASSWORD=TestPass123!

# Mode:
#   submit  — fill the form AND actually post the job (creates real DB rows).
#   dryrun  — fill the form, open the Preview overlay, assert the preview
#             matches the input, then CLOSE without submitting.
#             ← Safe to run against staging or production.
MODE=submit

# Show the browser window (set to "true" to watch tests live).
HEADED=false

# After each scenario completes in submit mode, delete the freshly-created
# job row from the DB. Requires DB_* credentials below (local only).
CLEANUP_JOBS=true

# Direct MySQL access for verifying that submitted fields match the DB row,
# and for cleanup. Skip these in MODE=dryrun (verification falls back to
# UI-only assertions).
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=zeronoticeperi_lyd_db
DB_USERNAME=laravel_user
DB_PASSWORD=password123
