{
  "name": "znp-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for the ZNP Post-a-Job form (and other UI flows).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:demo": "DEMO=true playwright test",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium chrome-for-testing"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.0"
  }
}
